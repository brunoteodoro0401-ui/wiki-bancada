# Copie este arquivo para .env e preencha os valores:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Em produção (PostgreSQL): ex. postgresql://usuario:senha@host:5432/dbname
# Se vazio, usa SQLite local (bancada.db)
DATABASE_URL=

# Segredo JWT fixo em produção
JWT_SECRET=

# Origens extras permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=
